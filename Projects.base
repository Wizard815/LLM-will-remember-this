filters:
  and:
    - type == "project"
    - or:
        - file.folder.endsWith("/wiki/1-projects")
        - file.folder.endsWith("/wiki/4-archive")
views:
  - type: table
    name: Active
    filters:
      and:
        - project_status == "active"
    order:
      - file.name
      - area
      - status
      - updated
  - type: table
    name: All
    order:
      - file.name
      - project_status
      - area
      - status
      - updated
  - type: table
    name: Paused
    filters:
      and:
        - project_status == "paused"
    order:
      - file.name
      - area
      - updated
  - type: table
    name: Archive
    filters:
      and:
        - project_status == "done"
    order:
      - file.name
      - area
      - updated
